# Vorlage für .env.production (NICHT einchecken). Alle Passwörter neu und zufällig erzeugen:
#   openssl rand -hex 24   (nur Hex-Zeichen, damit die Datenbank-URLs gültig bleiben)
POSTGRES_PASSWORD=
FANGEVO_OWNER_PASSWORD=
FANGEVO_APP_PASSWORD=
FANGEVO_BACKUP_PASSWORD=
# 32 Byte, base64: openssl rand -base64 32  (sicher aufbewahren – ohne ihn sind verschlüsselte Daten verloren)
APP_ENCRYPTION_KEY=
# Öffentliche Adresse (mit https), z. B. https://wawi.fangevo.de
WEB_ORIGIN=
WEB_PORT=8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="FangEvo Wawi Pro <no-reply@fangevo.de>"
PLATFORM_ADMIN_EMAILS=
SUPPORT_EMAIL=
PLATFORM_ISSUER_NAME=
PLATFORM_ISSUER_STREET=
PLATFORM_ISSUER_POSTAL_CODE=
PLATFORM_ISSUER_CITY=
PLATFORM_ISSUER_EMAIL=
PLATFORM_ISSUER_VAT_ID=
PLATFORM_ISSUER_TAX_NUMBER=
PLATFORM_ISSUER_IBAN=
PLATFORM_ISSUER_BIC=
PLATFORM_ISSUER_BANK_NAME=
