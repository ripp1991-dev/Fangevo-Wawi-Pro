// FangEvo Wawi Pro – Datenmodell Phase 1 (Core)
// Konvention: Tabellen und Spalten in snake_case, Modelle in PascalCase.
// Alle mandantenbezogenen Tabellen tragen account_id und sind per Row-Level Security geschützt
// (siehe Migration 0001_core, Abschnitt RLS).

generator client {
  provider      = "prisma-client-js"
  /// native = Entwicklungsrechner; debian-openssl-3.0.x = Produktions-Image (distroless, Debian 12)
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATE_URL")
}

// ───────────── Global (ohne Mandantenbezug) ─────────────

model User {
  id              String    @id @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String    @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc    String?   @map("mfa_secret_enc")
  lastAccountId   String?   @map("last_account_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  authTokens    AuthToken[]
  recoveryCodes MfaRecoveryCode[]
  memberships   Membership[]

  @@map("users")
}

model Session {
  id         String    @id @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  accountId  String?   @map("account_id") @db.Uuid
  mfaPending Boolean   @default(false) @map("mfa_pending")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// null = volle Sitzung; "packing" = PIN-Sitzung nur für den Packtisch (Firma + Gerät)
  scope          String?
  scopeCompanyId String? @map("scope_company_id") @db.Uuid
  deviceId       String? @map("device_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  MFA_SETUP
}

model AuthToken {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  payload   String?
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Sicherheitsereignisse eines Benutzers ohne Account-Bezug (z. B. fehlgeschlagener Login).
model SecurityEvent {
  id        String   @id @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  type      String
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("security_events")
}

// ───────────── Mandantenbezogen (RLS) ─────────────

enum AccountStatus {
  ACTIVE
  CLOSED
}

model Account {
  id        String        @id @db.Uuid
  name      String
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  companies   Company[]
  memberships Membership[]
  roles       Role[]
  entitlement Entitlement?

  @@map("accounts")
}

model Company {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  name         String
  legalName    String?   @map("legal_name")
  vatId        String?   @map("vat_id")
  street       String?
  postalCode   String?   @map("postal_code")
  city         String?
  country      String    @default("DE") @db.Char(2)
  email        String?
  phone        String?
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by") @db.Uuid
  version      Int       @default(1)
  /// Werte der kundeneigenen Felder (siehe CustomFieldDefinition), Schlüssel = Feld-Key
  customFields Json      @default("{}") @map("custom_fields")

  account Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  access  CompanyAccess[]

  @@index([accountId])
  @@map("companies")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id           String           @id @db.Uuid
  accountId    String           @map("account_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  isOwner      Boolean          @default(false) @map("is_owner")
  status       MembershipStatus @default(ACTIVE)
  allCompanies Boolean          @default(false) @map("all_companies")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  account     Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles       MembershipRole[]
  permissions MembershipPermission[]
  companies   CompanyAccess[]

  @@unique([accountId, userId])
  @@index([userId])
  @@map("memberships")
}

model CompanyAccess {
  accountId    String @map("account_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  companyId    String @map("company_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([membershipId, companyId])
  @@index([accountId])
  @@map("company_access")
}

model Role {
  id          String   @id @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  name        String
  description String?
  systemKey   String?  @map("system_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account     Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([accountId, name])
  @@map("roles")
}

model RolePermission {
  accountId  String @map("account_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([accountId])
  @@map("role_permissions")
}

model MembershipRole {
  accountId    String @map("account_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([accountId])
  @@map("membership_roles")
}

/// Einzelrechte, zusätzlich zu den Rollen.
model MembershipPermission {
  accountId    String @map("account_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  permission   String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, permission])
  @@index([accountId])
  @@map("membership_permissions")
}

model Invitation {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  email        String
  tokenHash    String    @unique @map("token_hash")
  roleIds      String[]  @map("role_ids") @db.Uuid
  allCompanies Boolean   @default(false) @map("all_companies")
  companyIds   String[]  @map("company_ids") @db.Uuid
  invitedBy    String    @map("invited_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("invitations")
}

enum EntitlementStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

/// Lizenz-Kern: was ein Account nutzen darf. Wird nur serverseitig ausgewertet.
model Entitlement {
  accountId     String            @id @map("account_id") @db.Uuid
  plan          String
  status        EntitlementStatus
  modules       String[]
  maxCompanies  Int               @map("max_companies")
  maxUsers      Int?              @map("max_users")
  maxConnectors Int?              @map("max_connectors")
  trialEndsAt   DateTime?         @map("trial_ends_at")
  validUntil    DateTime?         @map("valid_until")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("entitlements")
}

/// Lizenzhistorie (unveränderlich).
model EntitlementEvent {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  change    Json
  actor     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("entitlement_events")
}

/// Audit-Log (unveränderlich, per Trigger gegen UPDATE/DELETE geschützt).
model AuditLog {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  data       Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ───────────── Phase 2: Ereignisse, Benachrichtigungen, Werkzeuge ─────────────

/// Fachliches Ereignis (Outbox). Wird in derselben Transaktion wie die Änderung geschrieben.
model OutboxEvent {
  id          String   @id @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  type        String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Phase 6: Firma des Ereignisses (für Webhooks und Regeln)
  companyId   String?  @map("company_id") @db.Uuid
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("outbox_events")
}

/// Zustellwarteschlange für den Verteiler. Global (ohne Inhalt), damit der Worker
/// offene Ereignisse finden kann, ohne die Mandantentrennung zu umgehen.
model OutboxPending {
  eventId     String    @id @map("event_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  availableAt DateTime  @default(now()) @map("available_at")
  lockedUntil DateTime? @map("locked_until")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([availableAt])
  @@map("outbox_pending")
}

model Notification {
  id        String    @id @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  /// Verhindert Doppelzustellung (z. B. Ereignis-ID + Empfänger)
  dedupeKey String    @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([accountId, userId, dedupeKey])
  @@index([accountId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  accountId String  @map("account_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  type      String
  inApp     Boolean @map("in_app")

  @@id([accountId, userId, type])
  @@map("notification_preferences")
}

/// Gespeicherte Tabellenansicht (persönlich oder für den Account freigegeben)
model SavedView {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tableKey  String   @map("table_key")
  name      String
  state     Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId, tableKey])
  @@map("saved_views")
}

/// Kundeneigenes Feld für einen Datensatztyp (z. B. Firma)
model CustomFieldDefinition {
  id              String    @id @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  entityType      String    @map("entity_type")
  key             String
  label           String
  type            String
  options         Json?
  required        Boolean   @default(false)
  position        Int       @default(0)
  referenceEntity String?   @map("reference_entity")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([accountId, entityType, key])
  @@map("custom_field_definitions")
}

/// Einstellungen: user_id gesetzt = persönlich, user_id leer = Standard für den Account
model Preference {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId, key])
  @@map("preferences")
}

/// Dashboard-Seite: user_id gesetzt = persönlich, user_id leer = Vorlage für den Account
model Dashboard {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  name      String
  position  Int      @default(0)
  widgets   Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountId, userId])
  @@map("dashboards")
}

/// Suchindex für die globale Suche
model SearchDocument {
  accountId  String   @map("account_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  permission String
  title      String
  subtitle   String?
  body       String?
  url        String
  archived   Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([accountId, entityType, entityId])
  @@map("search_documents")
}

// ───────────── Phase 3a: Warenwirtschaft – Stammdaten und Lager ─────────────
// Alle Tabellen sind firmenbezogen: account_id + company_id, RLS prüft beides
// (app.account_id und app.company_id). Geldbeträge: numeric(19,4), nie Gleitkomma.

/// Einstellungen je Firma
model CompanySettings {
  companyId          String   @id @map("company_id") @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  allowNegativeStock Boolean  @default(false) @map("allow_negative_stock")
  currency           String   @default("EUR") @db.Char(3)
  // Angaben für Belege (§ 14 UStG: Steuernummer oder USt-IdNr. Pflicht auf Rechnungen)
  taxNumber          String?  @map("tax_number")
  managingDirector   String?  @map("managing_director")
  registerCourt      String?  @map("register_court")
  registerNumber     String?  @map("register_number")
  bankName           String?  @map("bank_name")
  iban               String?
  bic                String?
  documentFooter     String?  @map("document_footer")
  logoDataUrl        String?  @map("logo_data_url")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

/// Steuersätze, frei anlegbar je Firma (z. B. 19 %, 7 %, 0 %)
model TaxRate {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String
  rate       Decimal   @db.Decimal(5, 2)
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("tax_rates")
}

/// Lückenlose Nummernkreise je Firma (z. B. Artikel, Kunden, Lieferanten)
model NumberSequence {
  accountId String @map("account_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid
  key       String
  prefix    String @default("")
  nextValue Int    @default(1) @map("next_value")
  padding   Int    @default(5)

  @@id([companyId, key])
  @@map("number_sequences")
}

model Category {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  parentId   String?   @map("parent_id") @db.Uuid
  name       String
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([companyId, parentId])
  @@map("categories")
}

model Manufacturer {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  name       String
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@map("manufacturers")
}

model CustomerGroup {
  id              String    @id @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  name            String
  /// Preisanzeige für diese Gruppe: "gross" (brutto, z. B. Privatkunden) oder "net"
  priceDisplay    String    @default("gross") @map("price_display")
  discountPercent Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  isDefault       Boolean   @default(false) @map("is_default")
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, name])
  @@map("customer_groups")
}

model Article {
  id                String    @id @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  number            String
  /// standard | parent (Vaterartikel) | variant (Kindartikel) | set (Stückliste)
  kind              String    @default("standard")
  parentId          String?   @map("parent_id") @db.Uuid
  /// Bei Vaterartikeln: Variantenmerkmale {"Größe":["S","M"]}; bei Kindartikeln: Ausprägung {"Größe":"M"}
  variantAttributes Json?     @map("variant_attributes")
  name              String
  shortDescription  String?   @map("short_description")
  description       String?
  gtin              String?
  manufacturerId    String?   @map("manufacturer_id") @db.Uuid
  brand             String?
  categoryId        String?   @map("category_id") @db.Uuid
  unit              String    @default("Stück")
  taxRateId         String    @map("tax_rate_id") @db.Uuid
  purchasePriceNet  Decimal   @default(0) @map("purchase_price_net") @db.Decimal(19, 4)
  salePriceNet      Decimal   @default(0) @map("sale_price_net") @db.Decimal(19, 4)
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(12, 4)
  minStock          Decimal   @default(0) @map("min_stock") @db.Decimal(19, 4)
  stockTracked      Boolean   @default(true) @map("stock_tracked")
  trackBatches      Boolean   @default(false) @map("track_batches")
  trackSerials      Boolean   @default(false) @map("track_serials")
  trackBestBefore   Boolean   @default(false) @map("track_best_before")
  active            Boolean   @default(true)
  customFields      Json      @default("{}") @map("custom_fields")
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by") @db.Uuid
  version           Int       @default(1)

  @@unique([companyId, number])
  @@index([companyId, name])
  @@index([companyId, gtin])
  @@index([companyId, parentId])
  @@map("articles")
}

/// Staffel- und Kundengruppenpreise (netto). customer_group_id leer = für alle.
model ArticlePrice {
  id              String  @id @db.Uuid
  accountId       String  @map("account_id") @db.Uuid
  companyId       String  @map("company_id") @db.Uuid
  articleId       String  @map("article_id") @db.Uuid
  customerGroupId String? @map("customer_group_id") @db.Uuid
  minQuantity     Decimal @default(1) @map("min_quantity") @db.Decimal(19, 4)
  priceNet        Decimal @map("price_net") @db.Decimal(19, 4)

  @@index([articleId])
  @@map("article_prices")
}

/// Bestandteile eines Sets (Stückliste)
model SetComponent {
  accountId          String  @map("account_id") @db.Uuid
  companyId          String  @map("company_id") @db.Uuid
  setArticleId       String  @map("set_article_id") @db.Uuid
  componentArticleId String  @map("component_article_id") @db.Uuid
  quantity           Decimal @db.Decimal(19, 4)

  @@id([setArticleId, componentArticleId])
  @@map("set_components")
}

model Customer {
  id               String    @id @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  number           String
  /// private | business
  type             String    @default("private")
  companyName      String?   @map("company_name")
  salutation       String?
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  email            String?
  phone            String?
  vatId            String?   @map("vat_id")
  customerGroupId  String?   @map("customer_group_id") @db.Uuid
  paymentTermsDays Int       @default(14) @map("payment_terms_days")
  blocked          Boolean   @default(false)
  blockedReason    String?   @map("blocked_reason")
  notes            String?
  customFields     Json      @default("{}") @map("custom_fields")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.Uuid
  version          Int       @default(1)

  @@unique([companyId, number])
  @@index([companyId, lastName])
  @@index([companyId, companyName])
  @@map("customers")
}

/// Adressen von Kunden und Lieferanten (owner_type: customer | supplier)
model Address {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  ownerType  String   @map("owner_type")
  ownerId    String   @map("owner_id") @db.Uuid
  /// billing | shipping
  kind       String
  isDefault  Boolean  @default(false) @map("is_default")
  name       String?
  name2      String?
  street     String?
  postalCode String?  @map("postal_code")
  city       String?
  country    String   @default("DE") @db.Char(2)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@map("addresses")
}

/// Ansprechpartner von Kunden und Lieferanten
model Contact {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  ownerType String   @map("owner_type")
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  role      String?
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerType, ownerId])
  @@map("contacts")
}

model Supplier {
  id                  String    @id @db.Uuid
  accountId           String    @map("account_id") @db.Uuid
  companyId           String    @map("company_id") @db.Uuid
  number              String
  name                String
  email               String?
  phone               String?
  website             String?
  vatId               String?   @map("vat_id")
  customerNumber      String?   @map("customer_number")
  paymentTermsDays    Int       @default(30) @map("payment_terms_days")
  defaultDeliveryDays Int?      @map("default_delivery_days")
  notes               String?
  customFields        Json      @default("{}") @map("custom_fields")
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by") @db.Uuid
  version             Int       @default(1)

  @@unique([companyId, number])
  @@index([companyId, name])
  @@map("suppliers")
}

/// Lieferanten-Artikel: Bezugsquelle eines Artikels
model SupplierArticle {
  id               String   @id @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  articleId        String   @map("article_id") @db.Uuid
  supplierSku      String?  @map("supplier_sku")
  purchasePriceNet Decimal  @map("purchase_price_net") @db.Decimal(19, 4)
  deliveryDays     Int?     @map("delivery_days")
  minOrderQuantity Decimal  @default(1) @map("min_order_quantity") @db.Decimal(19, 4)
  isPreferred      Boolean  @default(false) @map("is_preferred")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([supplierId, articleId])
  @@index([articleId])
  @@map("supplier_articles")
}

model Warehouse {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  code       String
  name       String
  street     String?
  postalCode String?   @map("postal_code")
  city       String?
  country    String    @default("DE") @db.Char(2)
  isDefault  Boolean   @default(false) @map("is_default")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@map("warehouses")
}

model StorageLocation {
  id          String    @id @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  code        String
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([warehouseId, code])
  @@map("storage_locations")
}

/// Bestandsjournal: unveränderlich. Jede Bestandsänderung ist genau eine Buchung.
model StockMovement {
  id            String    @id @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  articleId     String    @map("article_id") @db.Uuid
  warehouseId   String    @map("warehouse_id") @db.Uuid
  locationId    String?   @map("location_id") @db.Uuid
  /// receipt | issue | transfer_out | transfer_in | correction
  type          String
  quantity      Decimal   @db.Decimal(19, 4)
  /// Bestand an diesem Ort nach der Buchung
  balanceAfter  Decimal   @map("balance_after") @db.Decimal(19, 4)
  batch         String?
  serialNumber  String?   @map("serial_number")
  bestBefore    DateTime? @map("best_before") @db.Date
  referenceType String?   @map("reference_type")
  referenceId   String?   @map("reference_id")
  transferId    String?   @map("transfer_id") @db.Uuid
  note          String?
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([companyId, articleId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

/// Aktueller Bestand je Artikel und Lager(platz); wird nur zusammen mit dem Journal geändert.
model StockLevel {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  articleId    String    @map("article_id") @db.Uuid
  warehouseId  String    @map("warehouse_id") @db.Uuid
  locationId   String?   @map("location_id") @db.Uuid
  /// Phase 4: Bestand je Charge/Seriennummer (leer = ohne Rückverfolgung)
  batch        String?
  serialNumber String?   @map("serial_number")
  bestBefore   DateTime? @map("best_before") @db.Date
  quantity     Decimal   @default(0) @db.Decimal(19, 4)
  reserved     Decimal   @default(0) @db.Decimal(19, 4)
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([companyId, articleId])
  @@map("stock_levels")
}

// ───────────── Phase 3b: Aufträge, Belege, Einkauf ─────────────

model SalesOrder {
  id               String    @id @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  number           String
  /// new | unchecked | in_progress | awaiting_payment | awaiting_stock | picking | packing | ready_to_ship | shipped | completed | cancelled
  status           String    @default("new")
  customerId       String    @map("customer_id") @db.Uuid
  /// Kundendaten zum Zeitpunkt der Bestellung (Name, Adressen, USt-IdNr.)
  customerSnapshot Json      @map("customer_snapshot")
  priceDisplay     String    @default("gross") @map("price_display")
  warehouseId      String    @map("warehouse_id") @db.Uuid
  orderDate        DateTime  @default(now()) @map("order_date")
  externalNumber   String?   @map("external_number")
  paymentMethod    String?   @map("payment_method")
  shippingMethod   String?   @map("shipping_method")
  shippingNet      Decimal   @default(0) @map("shipping_net") @db.Decimal(19, 4)
  shippingTaxRate  Decimal   @default(19) @map("shipping_tax_rate") @db.Decimal(5, 2)
  totalNet         Decimal   @default(0) @map("total_net") @db.Decimal(19, 4)
  totalTax         Decimal   @default(0) @map("total_tax") @db.Decimal(19, 4)
  totalGross       Decimal   @default(0) @map("total_gross") @db.Decimal(19, 4)
  notes            String?
  cancelReason     String?   @map("cancel_reason")
  shippedAt        DateTime? @map("shipped_at")
  /// Phase 5: Verkaufskanal, über den der Auftrag kam (leer = manuell)
  channelId        String?   @map("channel_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.Uuid
  version          Int       @default(1)

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("sales_orders")
}

model SalesOrderLine {
  id              String   @id @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  position        Int
  articleId       String?  @map("article_id") @db.Uuid
  articleNumber   String?  @map("article_number")
  name            String
  unit            String   @default("Stück")
  quantity        Decimal  @db.Decimal(19, 4)
  unitPriceNet    Decimal  @map("unit_price_net") @db.Decimal(19, 4)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxRate         Decimal  @map("tax_rate") @db.Decimal(5, 2)
  lineNet         Decimal  @map("line_net") @db.Decimal(19, 4)
  lineTax         Decimal  @map("line_tax") @db.Decimal(19, 4)
  lineGross       Decimal  @map("line_gross") @db.Decimal(19, 4)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("sales_order_lines")
}

/// Statusverlauf eines Auftrags (unveränderlich)
model OrderStatusHistory {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  note       String?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@map("order_status_history")
}

/// Reservierter Bestand für Auftragspositionen (verfügbar = Bestand − Reservierungen)
model StockReservation {
  id          String   @id @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  articleId   String   @map("article_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  orderLineId String   @map("order_line_id") @db.Uuid
  quantity    Decimal  @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId, articleId, warehouseId])
  @@index([orderId])
  @@map("stock_reservations")
}

/// Belege: Angebot, Auftragsbestätigung, Lieferschein, Rechnung, Gutschrift, Stornorechnung, Bestellung
model Document {
  id              String    @id @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  /// offer | order_confirmation | delivery_note | invoice | credit_note | cancellation | purchase_order
  type            String
  /// Nummer wird erst beim Festschreiben vergeben (lückenlos)
  number          String?
  /// draft | finalized
  status          String    @default("draft")
  orderId         String?   @map("order_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  relatedId       String?   @map("related_id") @db.Uuid
  recipient       Json
  lines           Json
  taxSummary      Json      @map("tax_summary")
  totalNet        Decimal   @map("total_net") @db.Decimal(19, 4)
  totalTax        Decimal   @map("total_tax") @db.Decimal(19, 4)
  totalGross      Decimal   @map("total_gross") @db.Decimal(19, 4)
  issueDate       DateTime  @map("issue_date") @db.Date
  serviceDate     DateTime? @map("service_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  notes           String?
  /// Rechnungen: unpaid | partially_paid | paid | cancelled
  paymentStatus   String?   @map("payment_status")
  finalizedAt     DateTime? @map("finalized_at")
  finalizedBy     String?   @map("finalized_by") @db.Uuid
  pdfSha256       String?   @map("pdf_sha256")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, type, number])
  @@index([companyId, type, issueDate])
  @@index([orderId])
  @@map("documents")
}

/// PDF eines festgeschriebenen Belegs (unveränderlich, GoBD)
model DocumentFile {
  documentId String   @id @map("document_id") @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  content    Bytes
  sha256     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("document_files")
}

/// Zahlungseingänge zu Rechnungen (unveränderlich; Korrektur durch Gegenbuchung)
model Payment {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  amount     Decimal  @db.Decimal(19, 4)
  paidOn     DateTime @map("paid_on") @db.Date
  method     String?
  reference  String?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([documentId])
  @@map("payments")
}

model PurchaseOrder {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  number       String
  /// draft | ordered | partially_received | received | cancelled
  status       String    @default("draft")
  supplierId   String    @map("supplier_id") @db.Uuid
  warehouseId  String    @map("warehouse_id") @db.Uuid
  expectedDate DateTime? @map("expected_date") @db.Date
  orderedAt    DateTime? @map("ordered_at")
  totalNet     Decimal   @default(0) @map("total_net") @db.Decimal(19, 4)
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")
  version      Int       @default(1)

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String  @id @db.Uuid
  accountId        String  @map("account_id") @db.Uuid
  companyId        String  @map("company_id") @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  position         Int
  articleId        String  @map("article_id") @db.Uuid
  articleNumber    String  @map("article_number")
  supplierSku      String? @map("supplier_sku")
  name             String
  unit             String
  quantity         Decimal @db.Decimal(19, 4)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(19, 4)
  unitPriceNet     Decimal @map("unit_price_net") @db.Decimal(19, 4)
  lineNet          Decimal @map("line_net") @db.Decimal(19, 4)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

/// Wareneingang (unveränderlich); die Bestandsbuchung steht im Bestandsjournal
model GoodsReceipt {
  id              String   @id @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  lines           Json
  note            String?
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

// ───────────── Phase 4: Logistik ─────────────

/// Zusätzliche Barcodes je Artikel (neben der GTIN), z. B. Lieferanten-EAN
model ArticleBarcode {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  code      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, code])
  @@index([articleId])
  @@map("article_barcodes")
}

model PickList {
  id          String    @id @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  number      String
  /// open | in_progress | done | cancelled
  status      String    @default("open")
  warehouseId String    @map("warehouse_id") @db.Uuid
  assignedTo  String?   @map("assigned_to") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by") @db.Uuid
  completedAt DateTime? @map("completed_at")

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("pick_lists")
}

model PickListLine {
  id             String  @id @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  companyId      String  @map("company_id") @db.Uuid
  pickListId     String  @map("pick_list_id") @db.Uuid
  position       Int
  orderId        String  @map("order_id") @db.Uuid
  orderLineId    String  @map("order_line_id") @db.Uuid
  articleId      String  @map("article_id") @db.Uuid
  articleNumber  String  @map("article_number")
  name           String
  locationId     String? @map("location_id") @db.Uuid
  batch          String?
  quantity       Decimal @db.Decimal(19, 4)
  pickedQuantity Decimal @default(0) @map("picked_quantity") @db.Decimal(19, 4)

  @@index([pickListId])
  @@index([orderId])
  @@map("pick_list_lines")
}

model PackingStation {
  id             String    @id @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  defaultCarrier String    @default("manual") @map("default_carrier")
  /// Lager, in dem der Packplatz steht (null = alle Lager der Firma, Altbestand)
  warehouseId    String?   @map("warehouse_id") @db.Uuid
  /// z. B. {"autoInvoice":true,"autoDeliveryNote":true}
  settings       Json      @default("{}")
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@index([companyId, warehouseId])
  @@map("packing_stations")
}

/// Für die PIN-Anmeldung freigegebener Lagerrechner (Token nur als Hash)
model PackingDevice {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  stationId  String    @map("station_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([companyId])
  @@map("packing_devices")
}

/// PIN für die Anmeldung am Packtisch (Argon2id), je Person und Account
model PackerPin {
  id             String    @id @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  pinHash        String    @map("pin_hash")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  updatedBy      String    @map("updated_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([accountId, userId])
  @@map("packer_pins")
}

/// Sendung eines Auftrags (ein oder mehrere Pakete)
model Shipment {
  id             String   @id @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  number         String
  orderId        String   @map("order_id") @db.Uuid
  stationId      String?  @map("station_id") @db.Uuid
  /// manual | own_label
  carrier        String
  trackingNumber String?  @map("tracking_number")
  /// [{"weightKg":"1.2","lengthCm":30,...}]
  parcels        Json
  /// verpackte Positionen inkl. Charge/Seriennummer
  items          Json
  labelPdf       Bytes?   @map("label_pdf")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String?  @map("created_by") @db.Uuid

  @@unique([companyId, number])
  @@index([orderId])
  @@map("shipments")
}

model Return {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  number       String
  orderId      String    @map("order_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  /// open | received | cancelled
  status       String    @default("open")
  reason       String?
  notes        String?
  warehouseId  String    @map("warehouse_id") @db.Uuid
  receivedAt   DateTime? @map("received_at")
  creditNoteId String?   @map("credit_note_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([orderId])
  @@map("returns")
}

model ReturnLine {
  id            String  @id @db.Uuid
  accountId     String  @map("account_id") @db.Uuid
  companyId     String  @map("company_id") @db.Uuid
  returnId      String  @map("return_id") @db.Uuid
  orderLineId   String  @map("order_line_id") @db.Uuid
  articleId     String? @map("article_id") @db.Uuid
  articleNumber String? @map("article_number")
  name          String
  quantity      Decimal @db.Decimal(19, 4)
  /// resell | damaged | scrap (beim Eingang festgelegt)
  condition     String?
  locationId    String? @map("location_id") @db.Uuid
  batch         String?
  serialNumber  String? @map("serial_number")

  @@index([returnId])
  @@map("return_lines")
}

// ───────────── Phase 5: Import, API, Multichannel ─────────────

/// Globale Warteschlange für Hintergrundaufgaben (nur IDs, keine Fachdaten; ohne RLS wie outbox_pending)
model JobQueue {
  id          String    @id @db.Uuid
  /// import | channel_sync | …
  kind        String
  accountId   String    @map("account_id") @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  refId       String    @map("ref_id") @db.Uuid
  availableAt DateTime  @default(now()) @map("available_at")
  lockedUntil DateTime? @map("locked_until")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([availableAt])
  @@map("job_queue")
}

model ImportJob {
  id            String    @id @db.Uuid
  accountId     String    @map("account_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  entity        String
  /// uploaded | validated | queued | running | done | failed | rolled_back
  status        String    @default("uploaded")
  fileName      String    @map("file_name")
  headers       Json
  rows          Json
  config        Json?
  totalRows     Int       @default(0) @map("total_rows")
  processedRows Int       @default(0) @map("processed_rows")
  okRows        Int       @default(0) @map("ok_rows")
  errorRows     Int       @default(0) @map("error_rows")
  /// [{row, message}] (höchstens 1000)
  errors        Json      @default("[]")
  dryRun        Json?     @map("dry_run")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([companyId, createdAt])
  @@map("import_jobs")
}

/// Was ein Import angelegt oder geändert hat (für Historie und Rückgängig)
model ImportJobRecord {
  id         String @id @db.Uuid
  accountId  String @map("account_id") @db.Uuid
  companyId  String @map("company_id") @db.Uuid
  jobId      String @map("job_id") @db.Uuid
  rowNumber  Int    @map("row_number")
  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid
  /// created | updated | booked
  action     String

  @@index([jobId])
  @@map("import_job_records")
}

model ImportTemplate {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  entity    String
  name      String
  columns   Json
  config    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([companyId, entity, name])
  @@map("import_templates")
}

/// API-Schlüssel einer Firma (nur der Hash wird gespeichert)
model ApiKey {
  id          String    @id @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  /// erste Zeichen zur Wiedererkennung, z. B. "fe_live_3fA9"
  prefix      String
  permissions String[]
  createdBy   String    @map("created_by") @db.Uuid
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  lastUsedIp  String?   @map("last_used_ip")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@map("api_keys")
}

/// Globale Zuordnung Schlüssel-Hash → Account (ohne RLS, ohne Fachdaten)
model ApiKeyIndex {
  hash      String @id
  keyId     String @unique @map("key_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  companyId String @map("company_id") @db.Uuid

  @@map("api_key_index")
}

model SalesChannel {
  id          String    @id @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  /// api (eigener Shop über API); weitere Typen erst nach Sandbox-Test
  type        String
  name        String
  active      Boolean   @default(true)
  config      Json      @default("{}")
  /// verschlüsselte Zugangsdaten (AES-256-GCM)
  secretsEnc  String?   @map("secrets_enc")
  warehouseId String    @map("warehouse_id") @db.Uuid
  apiKeyId    String?   @map("api_key_id") @db.Uuid
  status      String    @default("ok")
  lastSyncAt  DateTime? @map("last_sync_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  archivedAt  DateTime? @map("archived_at")

  @@unique([companyId, name])
  @@map("sales_channels")
}

model ChannelLog {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  /// info | warning | error
  level     String
  message   String
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([channelId, createdAt])
  @@map("channel_logs")
}

/// Kanalbezogene Artikeldaten (aktiv im Kanal, abweichender Preis)
model ChannelListing {
  accountId String   @map("account_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  active    Boolean  @default(true)
  priceNet  Decimal? @map("price_net") @db.Decimal(19, 4)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([channelId, articleId])
  @@map("channel_listings")
}

/// Zuordnung externer IDs (z. B. Bestellnummer im Shop) zu internen Datensätzen
model ExternalRef {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  channelId  String   @map("channel_id") @db.Uuid
  entityType String   @map("entity_type")
  externalId String   @map("external_id")
  internalId String   @map("internal_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([channelId, entityType, externalId])
  @@index([internalId])
  @@map("external_refs")
}

// ───────────── Phase 6: Automatisierung ─────────────

model Webhook {
  id             String    @id @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  url            String
  events         String[]
  /// Signaturschlüssel, verschlüsselt (AES-256-GCM)
  secretEnc      String    @map("secret_enc")
  active         Boolean   @default(true)
  failureCount   Int       @default(0) @map("failure_count")
  disabledReason String?   @map("disabled_reason")
  lastStatus     Int?      @map("last_status")
  lastDeliveryAt DateTime? @map("last_delivery_at")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  archivedAt     DateTime? @map("archived_at")

  @@index([companyId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String    @id @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  webhookId      String    @map("webhook_id") @db.Uuid
  eventId        String?   @map("event_id") @db.Uuid
  eventType      String    @map("event_type")
  payload        Json
  /// pending | delivered | failed
  status         String    @default("pending")
  attempts       Int       @default(0)
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body")
  error          String?
  deliveredAt    DateTime? @map("delivered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([webhookId, eventId])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model WorkflowRule {
  id             String    @id @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  name           String
  active         Boolean   @default(false)
  triggerType    String    @map("trigger_type")
  currentVersion Int       @default(1) @map("current_version")
  runAs          String    @map("run_as") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  archivedAt     DateTime? @map("archived_at")

  @@index([companyId, triggerType])
  @@map("workflow_rules")
}

/// Jede gespeicherte Fassung einer Regel (unveränderlich)
model WorkflowVersion {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  ruleId     String   @map("rule_id") @db.Uuid
  version    Int
  definition Json
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([ruleId, version])
  @@map("workflow_versions")
}

model WorkflowRun {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  ruleId     String    @map("rule_id") @db.Uuid
  version    Int
  /// queued | success | skipped | failed | test
  status     String    @default("queued")
  eventType  String    @map("event_type")
  eventId    String?   @map("event_id") @db.Uuid
  entityId   String?   @map("entity_id")
  context    Json?
  steps      Json      @default("[]")
  error      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")

  @@unique([ruleId, eventId, entityId])
  @@index([ruleId, createdAt])
  @@map("workflow_runs")
}

/// Fälligkeiten zeitgesteuerter Regeln (global, nur IDs)
model WorkflowSchedule {
  ruleId    String   @id @map("rule_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  nextRunAt DateTime @map("next_run_at")

  @@index([nextRunAt])
  @@map("workflow_schedule")
}

// ───────────── Phase 7: Kommerzialisierung ─────────────

/// Abo eines Accounts (ein Abo je Account)
model Subscription {
  accountId          String    @id @map("account_id") @db.Uuid
  plan               String
  /// month | year
  interval           String    @default("month")
  /// trialing | active | past_due | canceled
  status             String    @default("trialing")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  /// Herabstufung zum Laufzeitende
  scheduledPlan      String?   @map("scheduled_plan")
  /// Wechsel monatlich/jährlich zum Laufzeitende
  scheduledInterval  String?   @map("scheduled_interval")
  /// Von FangEvo gesperrt (nur lesen)
  suspendedAt        DateTime? @map("suspended_at")
  /// Zusätzlich gebuchte Firmen über die im Paket enthaltenen
  extraCompanies     Int       @default(0) @map("extra_companies")
  /// invoice (Überweisung); weitere Zahlarten nach Anbieter-Entscheidung
  paymentMethod      String    @default("invoice") @map("payment_method")
  billingName        String?   @map("billing_name")
  billingStreet      String?   @map("billing_street")
  billingPostalCode  String?   @map("billing_postal_code")
  billingCity        String?   @map("billing_city")
  billingCountry     String    @default("DE") @map("billing_country") @db.Char(2)
  billingVatId       String?   @map("billing_vat_id")
  billingEmail       String?   @map("billing_email")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("subscriptions")
}

model SubscriptionAddon {
  id          String    @id @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  module      String
  /// trial | active | canceled
  status      String
  trialEndsAt DateTime? @map("trial_ends_at")
  startedAt   DateTime  @default(now()) @map("started_at")
  /// Bei Kündigung: Ende der bezahlten Laufzeit
  endsAt      DateTime? @map("ends_at")

  @@unique([accountId, module])
  @@map("subscription_addons")
}

/// Rechnungen von FangEvo an den Kunden (Abo)
model PlatformInvoice {
  id          String    @id @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  number      String    @unique
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  lines       Json
  totalNet    Decimal   @map("total_net") @db.Decimal(19, 4)
  totalTax    Decimal   @map("total_tax") @db.Decimal(19, 4)
  totalGross  Decimal   @map("total_gross") @db.Decimal(19, 4)
  /// open | paid | void
  status      String    @default("open")
  pdf         Bytes
  sha256      String
  issuedAt    DateTime  @default(now()) @map("issued_at")
  dueDate     DateTime  @map("due_date") @db.Date
  paidAt      DateTime? @map("paid_at")

  @@index([accountId, issuedAt])
  @@map("platform_invoices")
}

/// Globale Zähler der Plattform (z. B. Rechnungsnummern von FangEvo)
model PlatformCounter {
  key   String @id
  value Int    @default(0)

  @@map("platform_counters")
}

/// Verzeichnis der Accounts für die Plattform-Verwaltung (global, nur Kennzahlen)
model PlatformAccount {
  accountId  String   @id @map("account_id") @db.Uuid
  name       String
  ownerEmail String?  @map("owner_email")
  plan       String
  status     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("platform_accounts")
}

model SupportTicket {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  number    String
  subject   String
  /// question | bug | billing | feature
  category  String
  /// low | normal | high | urgent
  priority  String   @default("normal")
  /// open | waiting_support | waiting_customer | closed
  status    String   @default("waiting_support")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountId, number])
  @@map("support_tickets")
}

model SupportMessage {
  id           String   @id @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorUserId String?  @map("author_user_id") @db.Uuid
  authorName   String   @map("author_name")
  fromSupport  Boolean  @default(false) @map("from_support")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Postfach-Index für das Support-Team (global, nur IDs und Status)
model SupportTicketIndex {
  ticketId  String   @id @map("ticket_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  status    String
  priority  String
  updatedAt DateTime @map("updated_at")

  @@index([status, updatedAt])
  @@map("support_ticket_index")
}
