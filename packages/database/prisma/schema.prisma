// FangEvo Wawi Pro – Datenmodell Phase 1 (Core)
// Konvention: Tabellen und Spalten in snake_case, Modelle in PascalCase.
// Alle mandantenbezogenen Tabellen tragen account_id und sind per Row-Level Security geschützt
// (siehe Migration 0001_core, Abschnitt RLS).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATE_URL")
}

// ───────────── Global (ohne Mandantenbezug) ─────────────

model User {
  id                String    @id @db.Uuid
  email             String    @unique
  name              String
  passwordHash      String    @map("password_hash")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc      String?   @map("mfa_secret_enc")
  lastAccountId     String?   @map("last_account_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  authTokens    AuthToken[]
  recoveryCodes MfaRecoveryCode[]
  memberships   Membership[]

  @@map("users")
}

model Session {
  id           String    @id @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  userId       String    @map("user_id") @db.Uuid
  accountId    String?   @map("account_id") @db.Uuid
  mfaPending   Boolean   @default(false) @map("mfa_pending")
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  MFA_SETUP
}

model AuthToken {
  id        String        @id @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  payload   String?
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Sicherheitsereignisse eines Benutzers ohne Account-Bezug (z. B. fehlgeschlagener Login).
model SecurityEvent {
  id        String   @id @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  type      String
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("security_events")
}

// ───────────── Mandantenbezogen (RLS) ─────────────

enum AccountStatus {
  ACTIVE
  CLOSED
}

model Account {
  id        String        @id @db.Uuid
  name      String
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  companies   Company[]
  memberships Membership[]
  roles       Role[]
  entitlement Entitlement?

  @@map("accounts")
}

model Company {
  id         String    @id @db.Uuid
  accountId  String    @map("account_id") @db.Uuid
  name       String
  legalName  String?   @map("legal_name")
  vatId      String?   @map("vat_id")
  street     String?
  postalCode String?   @map("postal_code")
  city       String?
  country    String    @default("DE") @db.Char(2)
  email      String?
  phone      String?
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by") @db.Uuid
  version    Int       @default(1)

  account Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  access  CompanyAccess[]

  @@index([accountId])
  @@map("companies")
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model Membership {
  id           String           @id @db.Uuid
  accountId    String           @map("account_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  isOwner      Boolean          @default(false) @map("is_owner")
  status       MembershipStatus @default(ACTIVE)
  allCompanies Boolean          @default(false) @map("all_companies")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  account     Account                @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles       MembershipRole[]
  permissions MembershipPermission[]
  companies   CompanyAccess[]

  @@unique([accountId, userId])
  @@index([userId])
  @@map("memberships")
}

model CompanyAccess {
  accountId    String @map("account_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  companyId    String @map("company_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([membershipId, companyId])
  @@index([accountId])
  @@map("company_access")
}

model Role {
  id          String   @id @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  name        String
  description String?
  systemKey   String?  @map("system_key")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  account     Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  members     MembershipRole[]

  @@unique([accountId, name])
  @@map("roles")
}

model RolePermission {
  accountId  String @map("account_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([accountId])
  @@map("role_permissions")
}

model MembershipRole {
  accountId    String @map("account_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([accountId])
  @@map("membership_roles")
}

/// Einzelrechte, zusätzlich zu den Rollen.
model MembershipPermission {
  accountId    String @map("account_id") @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  permission   String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, permission])
  @@index([accountId])
  @@map("membership_permissions")
}

model Invitation {
  id           String    @id @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  email        String
  tokenHash    String    @unique @map("token_hash")
  roleIds      String[]  @map("role_ids") @db.Uuid
  allCompanies Boolean   @default(false) @map("all_companies")
  companyIds   String[]  @map("company_ids") @db.Uuid
  invitedBy    String    @map("invited_by") @db.Uuid
  expiresAt    DateTime  @map("expires_at")
  acceptedAt   DateTime? @map("accepted_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([accountId])
  @@map("invitations")
}

enum EntitlementStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

/// Lizenz-Kern: was ein Account nutzen darf. Wird nur serverseitig ausgewertet.
model Entitlement {
  accountId     String            @id @map("account_id") @db.Uuid
  plan          String
  status        EntitlementStatus
  modules       String[]
  maxCompanies  Int               @map("max_companies")
  maxUsers      Int?              @map("max_users")
  maxConnectors Int?              @map("max_connectors")
  trialEndsAt   DateTime?         @map("trial_ends_at")
  validUntil    DateTime?         @map("valid_until")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("entitlements")
}

/// Lizenzhistorie (unveränderlich).
model EntitlementEvent {
  id        String   @id @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  change    Json
  actor     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("entitlement_events")
}

/// Audit-Log (unveränderlich, per Trigger gegen UPDATE/DELETE geschützt).
model AuditLog {
  id         String   @id @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  data       Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
