# FangEvo Wawi Pro – Beispielkonfiguration. Kopieren nach .env und Werte anpassen.
# Niemals echte Zugangsdaten committen.

NODE_ENV=development

# Laufzeit-Rolle (ohne BYPASSRLS) – wird von der API verwendet
DATABASE_URL=postgresql://fangevo_app:fangevo_app_dev@localhost:5432/fangevo_dev
# Eigentümer-Rolle – nur für Migrationen
DATABASE_MIGRATE_URL=postgresql://fangevo_owner:fangevo_owner_dev@localhost:5432/fangevo_dev

REDIS_URL=redis://localhost:6379

API_PORT=3000
# Öffentliche URL der Web-App (für Links in E-Mails und CORS)
WEB_ORIGIN=http://localhost:5173

# 32 Byte, base64. Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# E-Mail. Ohne SMTP_HOST werden Mails nur ins Log geschrieben (nur Entwicklung).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="FangEvo Wawi Pro <no-reply@fangevo.local>"

# S3-kompatibler Speicher: derzeit nicht genutzt (Belege liegen in der Datenbank, ADR-008).
# Die Entwicklungsumgebung startet keinen Objektspeicher mehr; Werte erst setzen, wenn S3 benötigt wird.
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Plattform (Phase 7)
# FangEvo-Mitarbeiter mit Zugang zur Plattform-Verwaltung (Zwei-Faktor ist Pflicht), Komma-getrennt
PLATFORM_ADMIN_EMAILS=
# Support-Postfach für neue Tickets
SUPPORT_EMAIL=
# Absenderangaben auf FangEvo-Rechnungen (in Produktion Pflicht, bevor Abos aktiviert werden)
PLATFORM_ISSUER_NAME=
PLATFORM_ISSUER_STREET=
PLATFORM_ISSUER_POSTAL_CODE=
PLATFORM_ISSUER_CITY=
PLATFORM_ISSUER_COUNTRY=DE
PLATFORM_ISSUER_EMAIL=
PLATFORM_ISSUER_VAT_ID=
PLATFORM_ISSUER_TAX_NUMBER=
PLATFORM_ISSUER_IBAN=
PLATFORM_ISSUER_BIC=
PLATFORM_ISSUER_BANK_NAME=

# Shopify-App „FangEvo Wawi“ (docs/SHOPIFY.md). Werte aus dem Shopify Dev Dashboard selbst eintragen.
# Ohne SHOPIFY_CLIENT_ID ist die Shopify-Anbindung ausgeschaltet.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Nur für fremde Shops (öffentlicher Vertrieb): privater Schlüssel (PEM) und Schlüssel-ID
# SHOPIFY_PRIVATE_KEY_FILE=
# SHOPIFY_KEY_ID=
# SHOPIFY_API_VERSION=2026-10
# DHL Paket DE Versenden (docs/DHL.md). API-Schlüssel der App aus developer.dhl.com selbst eintragen.
# Ohne DHL_API_KEY ist DHL ausgeschaltet. DHL_ENV=sandbox erzeugt keine echten Sendungen.
DHL_API_KEY=
DHL_API_SECRET=
DHL_ENV=sandbox

# Abstand des automatischen Abgleichs in Minuten
# CHANNEL_SYNC_MINUTES=5
