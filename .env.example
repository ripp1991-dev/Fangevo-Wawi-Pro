# FangEvo Wawi Pro – Beispielkonfiguration. Kopieren nach .env und Werte anpassen.
# Niemals echte Zugangsdaten committen.

NODE_ENV=development

# Laufzeit-Rolle (ohne BYPASSRLS) – wird von der API verwendet
DATABASE_URL=postgresql://fangevo_app:fangevo_app_dev@localhost:5432/fangevo_dev
# Eigentümer-Rolle – nur für Migrationen
DATABASE_MIGRATE_URL=postgresql://fangevo_owner:fangevo_owner_dev@localhost:5432/fangevo_dev

REDIS_URL=redis://localhost:6379

API_PORT=3000
# Öffentliche URL der Web-App (für Links in E-Mails und CORS)
WEB_ORIGIN=http://localhost:5173

# 32 Byte, base64. Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# E-Mail. Ohne SMTP_HOST werden Mails nur ins Log geschrieben (nur Entwicklung).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="FangEvo Wawi Pro <no-reply@fangevo.local>"

# S3-kompatibler Speicher (ab Phase 3 genutzt)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=fangevo
S3_SECRET_KEY=fangevo-dev-secret
