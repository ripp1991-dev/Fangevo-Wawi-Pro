{
  "name": "fangevo-wawi-pro",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @fangevo/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @fangevo/database migrate:dev",
    "db:generate": "pnpm --filter @fangevo/database generate",
    "db:test:migrate": "pnpm --filter @fangevo/database test:migrate",
    "test:e2e": "node tests/e2e/core-flow.mjs && node tests/e2e/phase2-flow.mjs && node tests/e2e/phase3a-flow.mjs && node tests/e2e/phase3b-flow.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "playwright": "1.64.1"
  },
  "type": "module",
  "pnpm": {
    "overrides": {
      "fastify": "5.12.7",
      "deepmerge-ts": "8.0.2",
      "js-yaml": "5.5.0"
    }
  }
}
